# === Локальна розробка ===
# Запусти PostgreSQL: docker compose up -d
DATABASE_URL=postgresql://shopify:shopify@localhost:5432/subscription_admin

SUBSCRIPTION_API_URL=https://subscription.oplata.com.ua
SUBSCRIPTION_ADMIN_TOKEN=replace_with_your_admin_bearer_token

# Shopify CLI підставляє ці значення під час `npm run dev`:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=
# SHOPIFY_APP_URL=
